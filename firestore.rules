rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定ヘルパー（role == 'admin' または name == '樹'）
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name == '樹'
      );
    }

    // 自分自身か確認
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ========== users ==========
    match /users/{userId} {
      // 認証済みユーザーは全員読める
      allow read: if request.auth != null;

      // 新規作成: 自分のドキュメントのみ
      allow create: if isOwner(userId);

      // 更新:
      //   管理者は何でも更新可能
      //   本人はプロフィール項目（name, iconUrl, bio, updatedAt）のみ変更可能
      //   QRチェックイン時のポイント加算も許可（points, updatedAt）
      allow update: if isAdmin() ||
                    (isOwner(userId) &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['name', 'iconUrl', 'bio', 'updatedAt', 'points', 'disabled']));
    }

    // ========== chats ==========
    match /chats/{chatId} {
      // 認証済みは読める
      allow read: if request.auth != null;

      // 自分のメッセージのみ作成可能
      allow create: if request.auth != null &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.message is string &&
                    request.resource.data.message.size() > 0 &&
                    request.resource.data.message.size() <= 1000;

      // 自分のメッセージまたは管理者が削除可能
      allow delete: if request.auth != null &&
                    (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ========== events ==========
    match /events/{eventId} {
      // 認証済みは読める
      allow read: if request.auth != null;

      // 管理者のみ作成・更新・削除
      allow create, update, delete: if isAdmin();
    }

    // ========== announcements ==========
    match /announcements/{announcementId} {
      // 認証済みは読める
      allow read: if request.auth != null;

      // 管理者のみ作成・更新・削除
      allow create, update, delete: if isAdmin();
    }

    // ========== pointLogs ==========
    match /pointLogs/{logId} {
      // 本人または管理者が読める
      allow read: if request.auth != null &&
                  (resource.data.uid == request.auth.uid || isAdmin());

      // 管理者のみ作成（ユーザーはポイントを自己付与不可）
      allow create: if isAdmin();
    }

    // ========== checkins ==========
    match /checkins/{checkinId} {
      // 認証済みは読める
      allow read: if request.auth != null;

      // 自分のチェックインのみ作成可能
      allow create: if request.auth != null &&
                    request.resource.data.uid == request.auth.uid;

      // 管理者は削除可能
      allow delete: if isAdmin();
    }

  }
}
